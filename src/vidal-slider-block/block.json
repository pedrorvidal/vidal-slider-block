{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/vidal-slider-block",
	"version": "1.0.0",
	"title": "Vidal Slider Block",
	"category": "widgets",
	"icon": "images-alt2",
	"description": "Native Gutenberg block for creating image sliders, with autoplay, dot/arrow navigation and per-slide links.",
	"example": {},
	"attributes": {
		"images": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"layout": {
			"type": "string",
			"default": "boxed"
		},
		"interval": {
			"type": "number",
			"default": 3000
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"showDots": {
			"type": "boolean",
			"default": true
		},
		"showArrows": {
			"type": "boolean",
			"default": true
		},
		"heightDesktop": {
			"type": "number",
			"default": 500
		},
		"heightUnitDesktop": {
			"type": "string",
			"default": "px"
		},
		"heightMobile": {
			"type": "number",
			"default": 250
		},
		"heightUnitMobile": {
			"type": "string",
			"default": "px"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "vidal-slider-block",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
